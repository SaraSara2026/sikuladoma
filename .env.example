# Neon DB connection string
# Get yours at: https://console.neon.tech/
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://...

# JWT secret pro podepisování session tokenů.
# Vygeneruj: openssl rand -base64 48
# Musí být ≥ 32 znaků. Nikdy necommituj reálnou hodnotu, jen ji nastav
# v .env.local lokálně a v Vercel → Settings → Environment Variables produkčně.
JWT_SECRET=

# Affiliate/kontaktní odkaz na pojištění odpovědnosti pro šikuly bez pojištění
# (dashboard, karta "Chci pojištění odpovědnosti"). Musí mít VITE_ prefix, ať
# ho Vite zavede do frontend buildu. Dokud je prázdné, karta zobrazí
# needitovatelné tlačítko "Připravujeme".
VITE_INSURANCE_OFFER_URL=
